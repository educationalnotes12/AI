from collections import deque

def find_path(grid, start, goal):
    rows, cols = len(grid), len(grid[0])

    queue = deque([start])
    visited = {start}
    parent = {start: None}

    moves = [(-1, 0), (1, 0), (0, -1), (0, 1)]

    while queue:
        current = queue.popleft()

        if current == goal:
            path = []

            while current is not None:
                path.append(current)
                current = parent[current]

            return path[::-1], visited

        row, col = current

        for dr, dc in moves:
            nr, nc = row + dr, col + dc
            next_cell = (nr, nc)

            if (0 <= nr < rows and 0 <= nc < cols
                    and grid[nr][nc] == 0
                    and next_cell not in visited):

                visited.add(next_cell)
                parent[next_cell] = current
                queue.append(next_cell)

    return None, visited


rows = int(input("Enter rows: "))
cols = int(input("Enter columns: "))

if rows <= 0 or cols <= 0:
    print("Invalid grid size")
else:
    grid = []

    print("Enter grid values (0 = free, 1 = obstacle):")

    for i in range(rows):
        row = list(map(int, input().split()))

        if len(row) != cols or any(x not in [0, 1] for x in row):
            print("Invalid row")
            break

        grid.append(row)

    if len(grid) == rows:
        start = tuple(map(int, input("Enter start row and column: ").split()))
        goal = tuple(map(int, input("Enter goal row and column: ").split()))

        if (len(start) != 2 or len(goal) != 2
                or not (0 <= start[0] < rows and 0 <= start[1] < cols)
                or not (0 <= goal[0] < rows and 0 <= goal[1] < cols)):
            print("Invalid position")

        elif grid[start[0]][start[1]] == 1 or grid[goal[0]][goal[1]] == 1:
            print("Start and goal must be free cells")

        else:
            path, visited = find_path(grid, start, goal)

            print("States explored:", len(visited))

            if path:
                print("Path found:", path)
                print("Number of moves:", len(path) - 1)
            else:
                print("No path exists")
