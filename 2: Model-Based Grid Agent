grid = [
    [0,0,0],
    [0,1,0],
    [0,0,0]
]

position = [0,0]
goal = [2,2]
visited = []

print("----- GRID NAVIGATION -----")
print("intial position",position)
print("goal position",goal)
print("0 = Free Path, 1 = Obstacle")

while position != goal:

        x,y = position
        visited.append(position.copy())

        if y<2 and grid [x][y+1] == 0 and [x,y+1] not in visited:
            position = [x,y+1]
            action = "move right"

        elif x<2 and grid [x+1][y] == 0 and [x+1,y] not in visited:
            position = [x+1,y]
            action = "move down"

        elif y>0 and grid[x][y-1] == 0 and [x,y-1] not in visited:
            position = [x,y-1]
            action = "move left"

        else:
            print("path is not found")
        

        print("\nAction",action)
        print("current posotion:",position)
        print("visited position:",visited)

if position == goal:
    print("\n----- SUCCESS -----")
    print("Goal Reached Successfully!")
    print("Final Position:", position)
    print("Total Moves:", len(visited))
    print("Total Visited Cells:", len(visited))
    print("Final Path:", visited + [goal])
