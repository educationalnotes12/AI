def tower_of_hanoi(number_of_disks, source, auxiliary, destination, moves):

    if number_of_disks == 1:
        moves.append((source, destination))
        return

    tower_of_hanoi(
        number_of_disks - 1,
        source,
        destination,
        auxiliary,
        moves
    )

    moves.append((source, destination))

    tower_of_hanoi(
        number_of_disks - 1,
        auxiliary,
        source,
        destination,
        moves
    )


try:
    disks = int(input("Enter number of disks: "))

    if disks <= 0:
        print("Please enter a positive number of disks.")

    else:
        moves = []

        tower_of_hanoi(disks, "A", "B", "C", moves)

        print("\nTotal moves required:", len(moves))

        for step, (source, destination) in enumerate(moves, start=1):
            print(f"Move {step}: {source} -> {destination}")

except ValueError:
    print("Invalid input. Enter a whole number.")
