from collections import deque


def bfs_path(grid, start, goal):
    rows = len(grid)
    cols = len(grid[0])

    queue = deque([start])
    parent = {start: None}

    moves = [(-1, 0), (1, 0), (0, -1), (0, 1)]

    while queue:
        row, col = queue.popleft()
        current = (row, col)

        if current == goal:
            path = []

            while current is not None:
                path.append(current)
                current = parent[current]

            return path[::-1]

        for dr, dc in moves:
            nr = row + dr
            nc = col + dc
            next_cell = (nr, nc)

            if (0 <= nr < rows and 0 <= nc < cols
                    and grid[nr][nc] == 0
                    and next_cell not in parent):

                parent[next_cell] = current
                queue.append(next_cell)

    return None


rows = int(input("Enter number of rows: "))
cols = int(input("Enter number of columns: "))

if rows <= 0 or cols <= 0:
    print("Invalid grid size")
    raise SystemExit

grid = []

print("Enter grid values (0 = free, 1 = obstacle):")

for i in range(rows):
    row = list(map(int, input(f"Row {i}: ").split()))

    if len(row) != cols or any(x not in [0, 1] for x in row):
        print("Invalid row")
        raise SystemExit

    grid.append(row)

start = tuple(map(int, input("Enter start row and column: ").split()))
goal = tuple(map(int, input("Enter goal row and column: ").split()))

for position in [start, goal]:
    if len(position) != 2:
        print("Invalid position")
        raise SystemExit

    r, c = position

    if not (0 <= r < rows and 0 <= c < cols):
        print("Position outside grid")
        raise SystemExit

    if grid[r][c] == 1:
        print("Start and goal must be free cells")
        raise SystemExit

path = bfs_path(grid, start, goal)

if path:
    print("Path found:", path)
    print("Number of steps:", len(path) - 1)
else:
    print("No path exists")
