from collections import deque

grid =[
    [0,0,0,0],
    [1,1,0,1],
    [0,0,0,0],
    [0,1,1,0]
]

start = (0,0)
goal = (3,3)

def bfs():
    queue = deque([start])
    visited = [start]

    while queue:
        x,y = queue.popleft()

        if (x,y) == goal :
            print("goal reached:",goal)
            return 

        moves = [(0,1),(1,0),(0,-1),(-1,0)]
        
        for dx,dy in moves:
            nx,ny = x+dx , y+dy

            if(0 <= nx < 4 and 0 <= ny < 4 and grid[nx][ny]== 0 and (nx,ny) not in visited):

                visited.append((nx,ny))
                queue.append((nx,ny))
                print("visited:",(nx,ny))

    print("goal is not found")

bfs()
            
            
