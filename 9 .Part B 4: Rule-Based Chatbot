print("chatbot:hello! welcome to my chatbot")
print("chatbot:you can ask me about my name, age, or mood.")
print("Chatbot: Type 'bye' to exit.")

while True:

    user = input("You:").lower()

    if "hello" in user:
        print("Chatbot: Hello! How are you?")

    elif "name" in user:
        print("Chatbot: My name is Python Chatbot.")

    elif "how are you" in user:
        print("Chatbot: I am fine. Thank you!")

    elif "age" in user:
        print("Chatbot: I am just a computer program.")

    elif "weather" in user:
        print("Chatbot: Sorry, I cannot check live weather.")

    elif "bye" in user:
        print("Chatbot: Goodbye! Have a nice day.")
        break

    else:
        print("Chatbot: Sorry, I don't understand.")


